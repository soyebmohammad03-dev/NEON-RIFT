%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a7850fa7ce0d4735b79778144224bde, type: 3}
  m_Name: Mission_NightRun
  m_EditorClassIdentifier: NeonRift.Missions::NeonRift.Missions.MissionDefinition
  id: night_run
  displayName: Night Run
  tagline: "INFILTRATE SECTOR 7  \xB7  STEAL THE DATA CORE  \xB7  GET OUT"
  briefing: 'Sector 7''s Data Core sits in a walled compound at the heart of the district. The boulevard route is long but clean; the service alley is short, but hacking its gate logs an intrusion. Take the core and the grid locks the district down: gates seal, the trace starts. Reach the Rift Gate in the south-east before it finds you.'
  sceneName: NightRun
  developmentOnly: 0
  objectives:
  - id: reach_core
    kind: 0
    targetId: core_compound
    title: REACH THE DATA CORE
    detail: 'Boulevard: long and clean.  Service alley: short, but its gate logs intrusions.'
    securityLevel: 0
    timeLimit: 0
    timeoutReason: TIME EXPIRED
    eventsOnStart: []
    eventsOnComplete: []
  - id: hack_core
    kind: 1
    targetId: core_uplink
    title: BREACH THE DATA CORE
    detail: Stop on the uplink ring and hold E to extract the core.
    securityLevel: 0
    timeLimit: 0
    timeoutReason: 
    eventsOnStart: []
    eventsOnComplete:
    - core.breached
    - lockdown
  - id: escape
    kind: 0
    targetId: extraction
    title: ESCAPE TO THE RIFT GATE
    detail: The district is sealing. Beat the checkpoints or hack your way out.
    securityLevel: 2
    timeLimit: 80
    timeoutReason: "TRACE COMPLETE \u2014 YOU WERE FOUND"
    eventsOnStart:
    - escape.start
    eventsOnComplete: []
  eventsOnStart:
  - mission.start
  eventsOnComplete:
  - mission.complete
  eventsOnFail:
  - mission.failed
  announcements:
  - eventId: mission.start
    text: "SECTOR 7 GRID ONLINE  \xB7  FOLLOW THE CYAN BEACON"
    tone: 0
    delay: 4.5
    banner: 0
  - eventId: alley.gate.open
    text: ALLEY GATE OPEN
    tone: 3
    delay: 0.2
    banner: 0
  - eventId: core.breached
    text: THEFT DETECTED|SECTOR 7 LOCKDOWN INITIATED
    tone: 2
    delay: 0.15
    banner: 1
  - eventId: escape.start
    text: 'EXTRACTION: RIFT GATE, SOUTH-EAST TUNNEL'
    tone: 0
    delay: 4
    banner: 0
  - eventId: escape.start
    text: "ALLEY GATE CAN BE RE-HACKED  \xB7  COSTS HEAT"
    tone: 1
    delay: 7
    banner: 0
  heatTimePenalty: 25
  minimumTimeLimit: 30
