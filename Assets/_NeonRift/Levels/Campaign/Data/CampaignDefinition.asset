  id: neon_rift_campaign
  displayName: NEON RIFT
  level1: {fileID: 11400000, guid: 6dbb8108a4bcb4e23a90ef55ed634f2b, type: 2}
  level2: {fileID: 11400000, guid: f74ae611b541e4390adb2fc7bfc706ae, type: 2}
