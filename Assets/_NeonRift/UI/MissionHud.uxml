<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="hud-root" class="nr-hud" picking-mode="Ignore">
        <ui:VisualElement name="lockdown-frame" class="nr-hud-frame" picking-mode="Ignore" />
        <ui:VisualElement name="extract-frame" class="nr-hud-extract" picking-mode="Ignore" />

        <ui:VisualElement name="waypoint" class="nr-waypoint" picking-mode="Ignore">
            <ui:VisualElement name="waypoint-arrow" class="nr-waypoint__arrow" picking-mode="Ignore" />
            <ui:VisualElement class="nr-waypoint__diamond" picking-mode="Ignore" />
            <ui:Label name="waypoint-label" class="nr-waypoint__label" picking-mode="Ignore" />
            <ui:Label name="waypoint-distance" class="nr-waypoint__distance" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="objective" class="nr-objective" picking-mode="Ignore">
            <ui:Label name="objective-step" text="OBJECTIVE" class="nr-objective__step" picking-mode="Ignore" />
            <ui:Label name="objective-title" class="nr-objective__title" picking-mode="Ignore" />
            <ui:Label name="objective-detail" class="nr-objective__detail" picking-mode="Ignore" />
            <ui:Label name="objective-distance" class="nr-objective__distance" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="security" class="nr-security" picking-mode="Ignore">
            <ui:VisualElement class="nr-security__row" picking-mode="Ignore">
                <ui:Label text="SECTOR 7 GRID" class="nr-security__caption" picking-mode="Ignore" />
                <ui:Label name="security-state" text="CALM" class="nr-security__state" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="nr-heat" picking-mode="Ignore">
                <ui:VisualElement name="heat-fill" class="nr-heat__fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="heat-label" text="HEAT 0%" class="nr-heat__label" picking-mode="Ignore" />
            <ui:Label name="timer" class="nr-timer nr-hidden" picking-mode="Ignore" />
            <ui:Label name="countdown" class="nr-countdown nr-hidden" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="race" class="nr-race nr-hidden" picking-mode="Ignore">
            <ui:VisualElement class="nr-race__header" picking-mode="Ignore">
                <ui:Label name="race-position" text="P1" class="nr-race__position" picking-mode="Ignore" />
                <ui:Label name="race-count" text="/3" class="nr-race__count" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="race-gap" class="nr-race__gap" picking-mode="Ignore" />
            <ui:VisualElement name="race-rows" class="nr-race__rows" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="navigator" class="nr-nav" picking-mode="Ignore">
            <ui:Label name="nav-district" class="nr-nav__district" picking-mode="Ignore" />
            <ui:Label name="nav-street" class="nr-nav__street" picking-mode="Ignore" />
            <ui:VisualElement name="minimap-frame" class="nr-minimap" picking-mode="Ignore" />
            <ui:Label name="nav-route" class="nr-nav__route" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="terminal" picking-mode="Ignore" />

        <ui:VisualElement name="objective-complete" class="nr-stamp" picking-mode="Ignore">
            <ui:Label name="objective-complete-text" text="OBJECTIVE COMPLETE" class="nr-stamp__text" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="toasts" class="nr-toasts" picking-mode="Ignore" />

        <ui:VisualElement name="banner" class="nr-banner" picking-mode="Ignore">
            <ui:Label name="banner-title" class="nr-banner__title" picking-mode="Ignore" />
            <ui:Label name="banner-subtitle" class="nr-banner__subtitle" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="prompt" class="nr-prompt" picking-mode="Ignore">
            <ui:VisualElement class="nr-prompt__row" picking-mode="Ignore">
                <ui:Label name="prompt-key" text="E" class="nr-prompt__key" picking-mode="Ignore" />
                <ui:Label name="prompt-text" class="nr-prompt__text" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="nr-prompt__track" picking-mode="Ignore">
                <ui:VisualElement name="prompt-fill" class="nr-prompt__fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="prompt-hint" class="nr-prompt__hint" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="speedo" class="nr-speedo" picking-mode="Ignore">
            <ui:VisualElement class="nr-speedo__row" picking-mode="Ignore">
                <ui:Label name="speed" text="0" class="nr-speedo__speed" picking-mode="Ignore" />
                <ui:VisualElement class="nr-speedo__side" picking-mode="Ignore">
                    <ui:Label name="gear" text="N" class="nr-speedo__gear" picking-mode="Ignore" />
                    <ui:Label text="KM/H" class="nr-speedo__unit" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="nr-speedo__rpm-row" picking-mode="Ignore">
                <ui:VisualElement class="nr-speedo__rpm" picking-mode="Ignore">
                    <ui:VisualElement name="rpm-fill" class="nr-speedo__rpm-fill" picking-mode="Ignore" />
                    <ui:VisualElement name="rpm-ticks" class="nr-speedo__rpm-ticks" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="shift-light" class="nr-speedo__shift" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="vehicle-name" class="nr-speedo__vehicle" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="letterbox-top" class="nr-letterbox nr-letterbox--top" picking-mode="Ignore" />
        <ui:VisualElement name="letterbox-bottom" class="nr-letterbox nr-letterbox--bottom" picking-mode="Ignore" />

        <ui:VisualElement name="briefing" class="nr-brief" picking-mode="Ignore">
            <ui:Label name="brief-kicker" class="nr-brief__kicker" picking-mode="Ignore" />
            <ui:Label name="brief-title" class="nr-brief__title" picking-mode="Ignore" />
            <ui:Label name="brief-tagline" class="nr-brief__tagline" picking-mode="Ignore" />
            <ui:Label name="brief-text" class="nr-brief__text" picking-mode="Ignore" />
            <ui:Label text="OBJECTIVES" class="nr-brief__section" picking-mode="Ignore" />
            <ui:VisualElement name="brief-objectives" class="nr-brief__list" picking-mode="Ignore" />
            <ui:Label text="ON THE GRID" class="nr-brief__section" picking-mode="Ignore" />
            <ui:VisualElement name="brief-crew" class="nr-brief__list" picking-mode="Ignore" />
            <ui:Label name="brief-best" class="nr-brief__best" picking-mode="Ignore" />
            <ui:Label text="DRIVE TO BEGIN" class="nr-brief__go" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="results" class="nr-results nr-hidden">
            <ui:VisualElement name="results-panel" class="nr-results__panel">
                <ui:VisualElement class="nr-results__head">
                    <ui:VisualElement class="nr-results__head-text">
                        <ui:Label name="results-kicker" class="nr-results__kicker" />
                        <ui:Label name="results-title" class="nr-results__title" />
                        <ui:Label name="results-reason" class="nr-results__reason" />
                    </ui:VisualElement>
                    <ui:VisualElement name="results-grade" class="nr-grade">
                        <ui:Label name="results-grade-letter" class="nr-grade__letter" />
                        <ui:Label name="results-grade-score" class="nr-grade__score" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="nr-results__body">
                    <ui:VisualElement class="nr-results__col">
                        <ui:Label text="RUN" class="nr-results__section" />
                        <ui:VisualElement name="results-stats" class="nr-results__stats" />
                        <ui:Label name="results-best" class="nr-results__best" />
                    </ui:VisualElement>
                    <ui:VisualElement class="nr-results__col nr-results__col--right">
                        <ui:Label name="results-splits-caption" text="SPLITS" class="nr-results__section" />
                        <ui:VisualElement name="results-splits" class="nr-results__stats" />
                        <ui:Label name="results-crews-caption" text="CREWS" class="nr-results__section" />
                        <ui:VisualElement name="results-crews" class="nr-results__stats" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="nr-results__buttons">
                    <ui:Button name="retry-button" text="RETRY" class="nr-button nr-button--primary" />
                    <ui:Button name="continue-button" text="GARAGE" class="nr-button" />
                </ui:VisualElement>
                <ui:Label name="results-hint" text="E  RETRY   ·   ESC  GARAGE" class="nr-hint" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
